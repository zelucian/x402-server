# Copy to .env and adjust, or export these in the shell before starting.
# No private keys are ever needed — verification/settlement is delegated
# to the facilitator.

# Port the Express server listens on.
PORT=4021

# Public HTTPS origin where this API is reachable in production.
# Used in the discovery documents (/openapi.json servers, /.well-known/x402
# resource URLs). Locally it defaults to http://localhost:<PORT>.
PUBLIC_BASE_URL=https://your-public-origin.example

# Wallet that receives the payments (payTo). Default is the project wallet.
PAYTO_ADDRESS=0xD5954e77A5ED7a092350b6A8e2E197586A56BeA7

# CAIP-2 network id. Default is Base mainnet.
NETWORK=eip155:8453

# Price per call of GET /, in USD.
PRICE=$0.01

# x402 facilitator used for payment verification/settlement.
# Must publicly support { x402Version: 2, scheme: "exact", network:
# "eip155:8453" } — the x402.org facilitator is testnet-only, so the
# keyless PayAI facilitator is the default.
FACILITATOR_URL=https://facilitator.payai.network
